load "std.sys"
load "std.filesys"
load "std.csv"

if len(sys.argv) != 2 do
    println("Usage: " + filesys.abs_path(sys.argv$0) + " <your-csv-file>")
    sys.exit(1)
done

if not filesys.exists(sys.argv$1) do
    println('File not found: "' + filesys.abs_path(sys.argv$1) + '"')
    sys.exit(1)
done

r = csv.read(sys.argv$1)

println("r = " + to_str(r))
