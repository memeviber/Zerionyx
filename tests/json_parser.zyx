load "std.sys"
load "std.filesys"
load "std.json"

if len(sys.argv) != 2 do
    println("Usage: " + filesys.abs_path(sys.argv$0) + " <your-json-file>")
    sys.exit(1)
done

if not filesys.exists(sys.argv$1) do
    println('File not found: "' + filesys.abs_path(sys.argv$1) + '"')
    sys.exit(1)
done

j = filesys.read(sys.argv$1, "r")
r = json.parse(j)

println("r = " + to_str(r))
