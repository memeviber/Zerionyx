# std.csv

namespace csv
    defun parse(s)
        if type(s) != str do
            panic("First argument of 'parse' must be a string", "T")
        done
        return parse_csv_fp(s)
    done

    defun stringify(data)
        if type(data) != hashmap do
            panic("First argument of 'stringify' must be a hashmap", "T")
        done
        return stringify_csv_fp(data)
    done
done