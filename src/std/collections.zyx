# std.collections

namespace collections
    load "std.random"

    defun map(f, l)
        if type(l) != list do
            panic("Second argument of 'map' must be a list", "T")
        done
        if type(f) != func do
            panic("First argument of 'map' must be a function", "T")
        done
        r = []
        for i = 0 until len(l) do
            append(r, f(l$i))
        done
        return r
    done

    defun rand_int_list(l, m, m_)
        l_ = []
        for _ = 0 until l do
            append(l_, random.rand_int(m, m_))
        done
        return l_
    done

    defun rand_float_list(l, m, m_)
        l_ = []
        for _ = 0 until l do
            append(l_, random.rand_float(m, m_))
        done
        return l_
    done

    defun filter(f, l)
        if type(l) != list do
            panic("Second argument of 'filter' must be a list", "T")
        done
        if type(f) != func do
            panic("First argument of 'filter' must be a function", "T")
        done
        r = []
        for i = 0 until len(l) do
            if f(l$i) do
                append(r, l$i)
            done
        done
        return r
    done

    defun reduce(f, l, i)
        if type(l) != list do
            panic("Second argument of 'reduce' must be a list", "T")
        done
        if type(f) != func do
            panic("First argument of 'reduce' must be a function", "T")
        done
        acc = i
        for idx = 0 until len(l) do
            acc = f(acc, l$idx)
        done
        return acc
    done

    defun min(l)
        if type(l) != list do
            panic("First argument of 'min' must be a list", "T")
        done
        if len(l) == 0 do
            panic("First argument of 'min' must be a list of numbers", "T")
        done
        m = l$0
        for i = 0 until len(l) do
            if type(l$i) != int and type(l$i) != float and type(l$i) != cfloat do
                panic("First argument of 'min' must be a list of numbers", "T")
            done
            if (l$i) < m do
                m = l$i
            done
        done
        return m
    done

    defun max(l)
        if type(l) != list do
            panic("First argument of 'max' must be a list", "T")
        done
        if len(l) == 0 do
            panic("First argument of 'max' must be a list of numbers", "T")
        done
        m = l$0
        for i = 0 until len(l) do
            if type(l$i) != int and type(l$i) != float and type(l$i) != cfloat do
                panic("First argument of 'max' must be a list of numbers", "T")
            done
            if (l$i) > m do
                m = l$i
            done
        done
        return m
    done

    defun reverse(l)
        r = []
        if type(l) != list do
            panic("First argument of 'reverse' must be a list", "T")
        done
        for i = len(l) - 1 until -1 step -1 do
            append(r, l$i)
        done
        return r
    done

    defun zip(l, l_)
        r = []
        if type(l) != list do
            panic("First argument of 'zip' must be a list", "T")
        elif type(l_) != list do
            panic("Second argument of 'zip' must be a list", "T")
        done
        _l = min([len(l), len(l_)])
        for i = 0 until _l do
            append(r, [l$i, l_$i])
        done
        return r
    done

    defun zip_longest(l, l_)
        r = []
        if type(l) != list do
            panic("First argument of 'zip_longest' must be a list", "T")
        done
        if type(l_) != list do
            panic("Second argument of 'zip_longest' must be a list", "T")
        done
        m = max([len(l), len(l_)])
        for i = 0 until m do
            v1 = none
            v2 = none
            if i < len(l) do
                v1 = l$i
            done
            if i < len(l_) do
                v2 = l_$i
            done
            append(r, [v1, v2])
        done
        return r
    done

    defun sort(l, reverse=false)
        if type(l) != list do
            panic("First argument of 'sort' must be a list", "T")
        done
        if len(l) > 0 do
            first_type = type(l$0)
            is_str = (first_type == str)
            is_num = (first_type == int or first_type == float or first_type == cfloat)
            
            if not (is_str or is_num) do
                panic("All elements of the list must be either numbers or strings", "T")
            done
            
            for i = 1 until len(l) do
                t = type(l$i)
                if is_str and t != str do
                    panic("All elements of the list must be either numbers or strings", "T")
                elif is_num and (t != int and t != float and t != cfloat) do
                    panic("All elements of the list must be either numbers or strings", "T")
                done
            done
        done
        s = sort_fp(l, reverse)
        return s
    done

    defun count(l, v)
        if type(l) != list do
            panic("First argument of 'count' must be a list", "T")
        done
        c = 0
        for i = 0 until len(l) do
            if l$i == v do
                c = c + 1
            done
        done
        return c
    done

    defun index_of(l, v)
        if type(l) != list do
            panic("First argument of 'index_of' must be a list", "T")
        done
        for i = 0 until len(l) do
            if l$i == v do
                return i
            done
        done
        return none
    done

    defun merge(h1, h2)
        if type(h1) != hashmap or type(h2) != hashmap do
            panic("Both arguments of 'merge' must be hashmaps", "T")
        done
        r = clone(h1)
        it = items(h2)
        for i = 0 until len(it) do
            pair = it$i
            r$pair$0 = pair$1
        done
        return r
    done

    defun invert(h)
        if type(h) != hashmap do
            panic("First argument of 'invert' must be a hashmap", "T")
        done
        r = {}
        it = items(h)
        for i = 0 until len(it) do
            pair = it$i
            if type(pair$1) != str do
                panic("Cannot invert hashmap: all values in the original hashmap must be strings", "T")
            done
            r$pair$1 = pair$0
        done
        return r
    done

    defun from_keys(l, default=none)
        if type(l) != list do
            panic("First argument of 'from_keys' must be a list", "T")
        done
        r = {}
        for i = 0 until len(l) do
            if type(l$i) != str do
                panic("All keys in the list must be strings", "T")
            done
            r$l$i = default
        done
        return r
    done

    defun any(f, l)
        if type(l) != list do
            panic("Second argument of 'any' must be a list", "T")
        done
        if type(f) != func do
            panic("First argument of 'any' must be a function", "T")
        done
        for i = 0 until len(l) do
            if f(l$i) do
                return true
            done
        done
        return false
    done

    defun all(f, l)
        if type(l) != list do
            panic("Second argument of 'all' must be a list", "T")
        done
        if type(f) != func do
            panic("First argument of 'all' must be a function", "T")
        done
        for i = 0 until len(l) do
            if not f(l$i) do
                return false
            done
        done
        return true
    done

    defun find(f, l)
        if type(l) != list do
            panic("Second argument of 'find' must be a list", "T")
        done
        if type(f) != func do
            panic("First argument of 'find' must be a function", "T")
        done
        for i = 0 until len(l) do
            if f(l$i) do
                return l$i
            done
        done
        return none
    done

    defun unique(l)
        if type(l) != list do
            panic("First argument of 'unique' must be a list", "T")
        done
        r = []
        for i = 0 until len(l) do
            val = l$i
            if index_of(r, val) == none do
                append(r, val)
            done
        done
        return r
    done

    defun map_values(f, h)
        if type(h) != hashmap do
            panic("Second argument of 'map_values' must be a hashmap", "T")
        done
        if type(f) != func do
            panic("First argument of 'map_values' must be a function", "T")
        done
        r = {}
        it = items(h)
        for i = 0 until len(it) do
            pair = it$i
            r$pair$0 = f(pair$1)
        done
        return r
    done

    defun map_filter(f, h)
        if type(h) != hashmap do
            panic("Second argument of 'map_filter' must be a hashmap", "T")
        done
        if type(f) != func do
            panic("First argument of 'map_filter' must be a function", "T")
        done
        r = {}
        it = items(h)
        for i = 0 until len(it) do
            pair = it$i
            if f(pair$0, pair$1) do
                r$pair$0 = pair$1
            done
        done
        return r
    done
done
